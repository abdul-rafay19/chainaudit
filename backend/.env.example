APP_ENV=dev
DATABASE_URL=sqlite:///./chainaudit.db
UPLOAD_DIR=./data/uploads
RENDER_DIR=./data/renders
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=mock            # mock | anthropic | openai
LLM_MODEL=                   # set per provider; never hard-coded
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
EXTRACTION_CONCURRENCY=4
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=20
MAX_REEXTRACTIONS_PER_FIELD=2
WORKFLOW_TIMEOUT_SECONDS=600
MOCK_FAULTS=                 # comma list e.g. "lab_report.batch_id" (fault injection, mock only)
REPLAY_DIR=../demo_data/replays

REPLAY_STEP_SECONDS=0.35

# Free providers (OpenAI-compatible): LLM_PROVIDER=groq|nvidia|gemini
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
